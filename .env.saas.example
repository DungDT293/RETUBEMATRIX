# ============================================================================
# RETubeMatrix SaaS Server Environment Configuration
# Điền các thông số lấy từ Supabase và Cloudflare vào đây
# ============================================================================

# 1. CẤU HÌNH SUPABASE (Lấy từ Project Settings -> API & Database)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_PASSWORD=your_database_password_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# 2. CẤU HÌNH CLOUDFLARE (Lấy từ dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_32_chars
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_WORKER_SUBDOMAIN=your-subdomain.workers.dev
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_id_here

# 3. BẢO MẬT GIAO TIẾP DESKTOP -> CLOUDFLARE EDGE
SHARED_TELEMETRY_HMAC_SECRET=generate_a_random_32_character_string_here
