{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RETubeMatrix",
  "version": "1.0.4",
  "identifier": "com.retubematrix.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RETubeMatrix",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src * asset: data: blob:; media-src * asset: data: blob:; connect-src 'self' ipc: tauri: http://ipc.localhost https: http:; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "msi", "nsis"],
    "resources": {
      "../browser_engine/actions/": "browser_engine/actions/",
      "../browser_engine/core/": "browser_engine/core/",
      "../browser_engine/outlier_hunter.py": "browser_engine/outlier_hunter.py",
      "../browser_engine/requirements.txt": "browser_engine/requirements.txt",
      "../browser_engine/runner.py": "browser_engine/runner.py",
      "../roots/": "roots/",
      "python/": "python/",
      "bin/": "bin/"
    },
    "externalBin": ["bin/retubematrix-yt-dlp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "template.nsi"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "cli": {
      "description": "RETubeMatrix - Hệ Thống Săn Đề Xuất & Reup Tự Động Bản Quyền YouTube",
      "longDescription": "RETubeMatrix - Mở ứng dụng desktop để săn đề xuất, reup và kiểm tra bản quyền ngầm.",
      "args": [
        {
          "name": "source",
          "index": 1,
          "takesValue": true,
          "description": "Video URL to download (e.g. https://www.youtube.com/watch?v=...)"
        },
        {
          "name": "url",
          "short": "u",
          "takesValue": true,
          "description": "Video URL to download (alternative to the positional argument)"
        },
        {
          "name": "quality",
          "short": "q",
          "takesValue": true,
          "description": "Video quality: best, 8k, 4k, 2k, 1080, 720, 480, 360. For audio use 128 or auto."
        },
        {
          "name": "output",
          "short": "o",
          "takesValue": true,
          "description": "Absolute output folder for this queued download"
        },
        {
          "name": "audio",
          "short": "a",
          "takesValue": false,
          "description": "Download audio only"
        },
        {
          "name": "queue-only",
          "takesValue": false,
          "description": "Only add the URL to the queue without starting the download"
        },
        {
          "name": "target",
          "short": "t",
          "takesValue": true,
          "description": "Routing target: auto (default), youtube, or universal"
        },
        {
          "name": "skip-live",
          "takesValue": false,
          "description": "Skip live, scheduled, or was-live videos before downloading"
        },
        {
          "name": "playlist",
          "takesValue": false,
          "description": "Allow yt-dlp to download playlist URLs"
        },
        {
          "name": "no-playlist",
          "takesValue": false,
          "description": "Force single-video download for playlist URLs"
        },
        {
          "name": "subtitle-mode",
          "takesValue": true,
          "description": "Subtitle mode: off, auto, or manual"
        },
        {
          "name": "subtitle-langs",
          "takesValue": true,
          "description": "Comma-separated subtitle languages, e.g. en,vi,ja"
        },
        {
          "name": "subtitle-format",
          "takesValue": true,
          "description": "Subtitle format: srt, vtt, or ass"
        },
        {
          "name": "embed-subs",
          "takesValue": false,
          "description": "Embed subtitles into the output file"
        },
        {
          "name": "download-sections",
          "takesValue": true,
          "description": "Time range as START-END, e.g. 00:30-02:10"
        },
        {
          "name": "live-from-start",
          "takesValue": false,
          "description": "Download livestreams from the beginning"
        }
      ]
    },
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["retubematrix", "youwee"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/DungDT293/RETUBEMATRIX/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCM0QyRkJFOUJBNjFENjgKUldSb0hhYWJ2aTg5Qyt6U2RMek5pNXMzaWRaa3FpSnBrMjlRWFNHUEYyRUwzUlJRbVQ0MGVaZEUK"
    }
  }
}
